# Squeaks core backend: add these to .env.local (and to Vercel project settings)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=            # server only, never NEXT_PUBLIC
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Comma separated Privy user ids (did:privy:...) allowed to use /api/squeaks/admin/*
SQ_ADMIN_IDS=

# CardicX Cheese API (CardicX is the only Cheese balance). Server only.
CARDICX_API_BASE=https://www.cardicx.com/api/partner/squeaks
SQUEAKS_PARTNER_SECRET=               # server only, never NEXT_PUBLIC; you add the value
# Optional: shorter Mine shifts for testing (seconds). Leave empty in production (24h).
SQ_MINE_SHIFT_SECONDS=
